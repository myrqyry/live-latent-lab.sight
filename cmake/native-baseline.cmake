# Native baseline uses the same maintained sources as the qualified Linux build.
# Optional Linux-only integrations are intentionally outside this configuration.
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(SIGHT_NATIVE_OBS_VERSION "" CACHE STRING "Exact native OBS SDK version")
if(SIGHT_NATIVE_OBS_VERSION)
    find_package(libobs ${SIGHT_NATIVE_OBS_VERSION} EXACT CONFIG REQUIRED)
else()
    find_package(libobs CONFIG REQUIRED)
endif()
if(NOT TARGET OBS::libobs)
    message(FATAL_ERROR "Native Sight requires OBS::libobs")
endif()
find_package(Threads REQUIRED)
set(SIGHT_JSON_INCLUDE "" CACHE PATH "Verified external nlohmann/json.hpp include root")
if(SIGHT_JSON_INCLUDE)
    if(NOT EXISTS "${SIGHT_JSON_INCLUDE}/nlohmann/json.hpp")
        message(FATAL_ERROR "Missing nlohmann JSON header")
    endif()
    add_library(sight_json INTERFACE)
    target_include_directories(sight_json INTERFACE "${SIGHT_JSON_INCLUDE}")
else()
    find_package(nlohmann_json 3.2 REQUIRED)
    add_library(sight_json INTERFACE)
    target_link_libraries(sight_json INTERFACE nlohmann_json::nlohmann_json)
endif()
set(SIGHT_ORT_ROOT "" CACHE PATH "Matching native ONNX Runtime SDK")
if(NOT SIGHT_ORT_ROOT OR NOT EXISTS "${SIGHT_ORT_ROOT}/include/onnxruntime_cxx_api.h")
    message(FATAL_ERROR "Supply native SIGHT_ORT_ROOT from tools/acquire-native-ort.py")
endif()
if(WIN32)
    set(ort_link "${SIGHT_ORT_ROOT}/lib/onnxruntime.lib")
    set(ort_runtime "${SIGHT_ORT_ROOT}/lib/onnxruntime.dll")
    set(ort_name onnxruntime.dll)
elseif(APPLE)
    set(ort_link "${SIGHT_ORT_ROOT}/lib/libonnxruntime.dylib")
    set(ort_runtime "${ort_link}")
    set(ort_name libonnxruntime.1.17.1.dylib)
else()
    set(ort_link "${SIGHT_ORT_ROOT}/lib/libonnxruntime.so")
    set(ort_runtime "${ort_link}")
    set(ort_name libonnxruntime.so.1.17.1)
endif()
foreach(path IN ITEMS "${ort_link}" "${ort_runtime}" "${SIGHT_ORT_ROOT}/LICENSE" "${SIGHT_ORT_ROOT}/ThirdPartyNotices.txt")
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "Missing native SDK input: ${path}")
    endif()
endforeach()
# A versioned runtime beside binaries makes the import name resolvable.
add_library(sight_ort SHARED IMPORTED)
set_target_properties(sight_ort PROPERTIES IMPORTED_LOCATION "${ort_runtime}" INTERFACE_INCLUDE_DIRECTORIES "${SIGHT_ORT_ROOT}/include")
if(WIN32)
    set_target_properties(sight_ort PROPERTIES IMPORTED_IMPLIB "${ort_link}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/baseline-sources.cmake")
add_library(live-latent-lab-sight MODULE ${SIGHT_BASELINE_SOURCES})
target_compile_definitions(live-latent-lab-sight PRIVATE SIGHT_ANIMEGAN_ONLY USE_ONNX_MEDIAPIPE)
if(WIN32)
    target_compile_definitions(live-latent-lab-sight PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN FACEDETECTION_EXPORT_SYMBOLS)
endif()
target_include_directories(live-latent-lab-sight PRIVATE src external/mediapipe-tasks-legacy/include external/mediapipe-tasks-123/include)
target_link_libraries(live-latent-lab-sight PRIVATE OBS::libobs sight_ort sight_json Threads::Threads ${CMAKE_DL_LIBS})
# Portable scalar face CNN: no architecture-specific AVX flags on ARM or MSVC.
set_target_properties(live-latent-lab-sight PROPERTIES PREFIX "")
if(APPLE)
    set_target_properties(live-latent-lab-sight PROPERTIES INSTALL_RPATH "@loader_path")
elseif(UNIX)
    set_target_properties(live-latent-lab-sight PROPERTIES INSTALL_RPATH "$ORIGIN")
endif()
# User-owned stage only; refuse native installer defaults and system roots.
install(CODE [[
    string(REPLACE "\\" "/" prefix "${CMAKE_INSTALL_PREFIX}")
    string(TOLOWER "${prefix}" prefix)
    if(prefix MATCHES "^/(usr|system|library|applications)(/|$)" OR
       prefix MATCHES "^[a-z]:/(windows|program files( [(]x86[)])?)(/|$)" OR
       prefix STREQUAL "/" OR prefix MATCHES "^[a-z]:/$")
        message(FATAL_ERROR "Sight refuses system-wide installation; use a user-owned stage directory")
    endif()
]])
install(TARGETS live-latent-lab-sight LIBRARY DESTINATION bin RUNTIME DESTINATION bin)
install(FILES "${ort_runtime}" DESTINATION bin RENAME "${ort_name}")
if(WIN32 AND EXISTS "${SIGHT_ORT_ROOT}/lib/onnxruntime_providers_shared.dll")
    install(FILES "${SIGHT_ORT_ROOT}/lib/onnxruntime_providers_shared.dll" DESTINATION bin)
endif()
set(SIGHT_JSON_NOTICE "" CACHE FILEPATH "Notice accompanying externally acquired JSON header")
if(SIGHT_JSON_INCLUDE AND NOT EXISTS "${SIGHT_JSON_NOTICE}")
    message(FATAL_ERROR "Supply matching external JSON notice")
endif()
if(SIGHT_JSON_NOTICE)
    install(FILES "${SIGHT_JSON_NOTICE}" DESTINATION data/licenses/nlohmann-json RENAME LICENSE)
endif()
install(FILES LICENSE LICENSING.md DESTINATION data/licenses/sight)
install(FILES "${SIGHT_ORT_ROOT}/LICENSE" "${SIGHT_ORT_ROOT}/ThirdPartyNotices.txt" DESTINATION data/licenses/onnxruntime)
install(FILES src/3rdparty/libfacedetection/LICENSE DESTINATION data/licenses/libfacedetection)
install(FILES src/vrm/vendor/tinygltf-LICENSE DESTINATION data/licenses/tinygltf RENAME LICENSE)
install(FILES src/vrm/vendor/stb-LICENSE DESTINATION data/licenses/stb RENAME LICENSE)
install(FILES data/locale/en-US.ini DESTINATION data/locale)
install(FILES data/presets/anime.json DESTINATION data/presets)
install(FILES data/sight-depth-camera.effect data/sight-privacy-conceal.effect data/sight-spatial-motion.effect data/sight-subject-matte.effect data/sight-text-obfuscation.effect data/sight-tracking-overlay.effect DESTINATION data)
enable_testing()
find_package(Python3 COMPONENTS Interpreter REQUIRED)
add_test(NAME sight_native_install_guard COMMAND "${Python3_EXECUTABLE}" -B "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_native_install_guard.py" "${CMAKE_BINARY_DIR}")
add_executable(sight_native_ort_smoke tests/native_ort_smoke.cpp)
target_include_directories(sight_native_ort_smoke PRIVATE src)
target_link_libraries(sight_native_ort_smoke PRIVATE sight_ort Threads::Threads)
add_custom_command(TARGET sight_native_ort_smoke POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${ort_runtime}" "$<TARGET_FILE_DIR:sight_native_ort_smoke>/${ort_name}")
if(APPLE)
    set_target_properties(sight_native_ort_smoke PROPERTIES BUILD_RPATH "@loader_path")
elseif(UNIX)
    set_target_properties(sight_native_ort_smoke PROPERTIES BUILD_RPATH "$ORIGIN")
endif()
add_test(NAME sight_native_ort_utf8 COMMAND sight_native_ort_smoke)
add_executable(sight_tasks_platform_policy tests/tasks_platform_policy_test.cpp)
target_include_directories(sight_tasks_platform_policy PRIVATE src)
add_test(NAME sight_tasks_platform_policy COMMAND sight_tasks_platform_policy)
add_executable(sight_native_vrm_asset tests/vrm_asset_test.cpp src/vrm/vrm_asset.cpp)
target_include_directories(sight_native_vrm_asset PRIVATE src)
target_link_libraries(sight_native_vrm_asset PRIVATE sight_json)
if(MSVC)
    target_compile_options(sight_native_vrm_asset PRIVATE /UNDEBUG /utf-8 /Zc:__cplusplus /bigobj)
    target_compile_definitions(sight_native_vrm_asset PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    target_compile_options(sight_native_ort_smoke PRIVATE /utf-8 /Zc:__cplusplus)
    target_compile_definitions(sight_native_ort_smoke PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    target_compile_options(live-latent-lab-sight PRIVATE /utf-8 /Zc:__cplusplus /bigobj)
else()
    target_compile_options(sight_native_vrm_asset PRIVATE -UNDEBUG)
endif()
add_test(NAME sight_native_vrm_asset COMMAND sight_native_vrm_asset)
message(STATUS "Sight native baseline: CPU/ONNX, VRM and scalar face detector; Linux-only optional backends are not enabled")
